<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Backend\Block\Template"
                   name="davidbel_ai_search_dashboard"
                   template="DavidBel_AiSearch::dashboard.phtml">
                <block class="DavidBel\AiSearch\Block\Adminhtml\Dashboard\Indexing"
                       name="davidbel_ai_search_dashboard_indexing"
                       as="indexing"
                       template="DavidBel_AiSearch::dashboard/indexing.phtml"/>
                <block class="DavidBel\AiSearch\Block\Adminhtml\Dashboard\Progress"
                       name="davidbel_ai_search_dashboard_progress"
                       as="progress"
                       template="DavidBel_AiSearch::dashboard/progress.phtml"/>
                <block class="DavidBel\AiSearch\Block\Adminhtml\Test\EmbedderConnectionButton"
                       name="davidbel_ai_search_dashboard_test_embedder_connection"
                       as="test_embedder_connection">
                    <arguments>
                        <argument name="id" xsi:type="string">ai_search_test_embedder_connection</argument>
                    </arguments>
                </block>
                <block class="DavidBel\AiSearch\Block\Adminhtml\Test\SemanticSearchButton"
                       name="davidbel_ai_search_dashboard_test_semantic_search"
                       as="test_semantic_search">
                    <arguments>
                        <argument name="id" xsi:type="string">ai_search_test_semantic_search</argument>
                    </arguments>
                </block>
            </block>
        </referenceContainer>
    </body>
</page>
