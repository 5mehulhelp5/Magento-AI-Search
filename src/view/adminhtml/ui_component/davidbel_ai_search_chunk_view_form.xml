<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider"
                  xsi:type="string">davidbel_ai_search_chunk_view_form.davidbel_ai_search_chunk_view_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Chunk Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="DavidBel\AiSearch\Block\Adminhtml\Chunk\View\BackButton"/>
        </buttons>
        <namespace>davidbel_ai_search_chunk_view_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>davidbel_ai_search_chunk_view_form.davidbel_ai_search_chunk_view_data_source</dep>
        </deps>
    </settings>
    <dataSource name="davidbel_ai_search_chunk_view_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <dataProvider class="DavidBel\AiSearch\Ui\DataProvider\Chunk\ViewDataProvider"
                      name="davidbel_ai_search_chunk_view_data_source">
            <settings>
                <requestFieldName>chunk_id</requestFieldName>
                <primaryFieldName>chunk_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">Chunk Information</label>
        </settings>
        <field name="chunk_id" formElement="input" sortOrder="10">
            <settings>
                <elementTmpl>ui/form/element/text</elementTmpl>
                <dataType>text</dataType>
                <dataScope>chunk_id</dataScope>
                <label translate="true">Chunk ID</label>
            </settings>
        </field>
        <field name="document_id" formElement="input" sortOrder="20">
            <settings>
                <elementTmpl>ui/form/element/text</elementTmpl>
                <dataType>text</dataType>
                <dataScope>document_id</dataScope>
                <label translate="true">Document ID</label>
            </settings>
        </field>
        <field name="chunk_index" formElement="input" sortOrder="30">
            <settings>
                <elementTmpl>ui/form/element/text</elementTmpl>
                <dataType>text</dataType>
                <dataScope>chunk_index</dataScope>
                <label translate="true">Chunk Index</label>
            </settings>
        </field>
        <field name="content" formElement="textarea" sortOrder="40">
            <settings>
                <disabled>true</disabled>
                <dataType>text</dataType>
                <dataScope>content</dataScope>
                <label translate="true">Content</label>
            </settings>
            <formElements>
                <textarea>
                    <settings>
                        <rows>20</rows>
                    </settings>
                </textarea>
            </formElements>
        </field>
        <field name="content_hash" formElement="input" sortOrder="50">
            <settings>
                <elementTmpl>ui/form/element/text</elementTmpl>
                <dataType>text</dataType>
                <dataScope>content_hash</dataScope>
                <label translate="true">Content Hash</label>
            </settings>
        </field>
        <field name="created_at" formElement="input" sortOrder="60">
            <settings>
                <elementTmpl>ui/form/element/text</elementTmpl>
                <dataType>text</dataType>
                <dataScope>created_at</dataScope>
                <label translate="true">Created</label>
            </settings>
        </field>
        <field name="updated_at" formElement="input" sortOrder="70">
            <settings>
                <elementTmpl>ui/form/element/text</elementTmpl>
                <dataType>text</dataType>
                <dataScope>updated_at</dataScope>
                <label translate="true">Updated</label>
            </settings>
        </field>
    </fieldset>
</form>
