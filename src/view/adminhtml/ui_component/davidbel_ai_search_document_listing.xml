<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider"
                  xsi:type="string">davidbel_ai_search_document_listing.davidbel_ai_search_document_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>davidbel_ai_search_document_columns</spinner>
        <deps>
            <dep>davidbel_ai_search_document_listing.davidbel_ai_search_document_data_source</dep>
        </deps>
    </settings>
    <dataSource name="davidbel_ai_search_document_data_source"
                component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">document_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>DavidBel_AiSearch::documents</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="davidbel_ai_search_document_data_source">
            <settings>
                <requestFieldName>document_id</requestFieldName>
                <primaryFieldName>document_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="davidbel_ai_search_document_columns">
        <column name="document_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="source_entity_type" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Source Entity Type</label>
            </settings>
        </column>
        <column name="source_entity_id"
                class="DavidBel\AiSearch\Ui\Component\Listing\Column\Document\ProductEditLink"
                sortOrder="30">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Source Entity ID</label>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
            </settings>
        </column>
        <column name="store_id"
                class="Magento\Store\Ui\Component\Listing\Column\Store"
                sortOrder="40">
            <settings>
                <filter>select</filter>
                <options class="Magento\Store\Ui\Component\Listing\Column\Store\Options"/>
                <dataType>select</dataType>
                <label translate="true">Store View</label>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
            </settings>
        </column>
        <column name="source_code" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Source Code</label>
            </settings>
        </column>
        <column name="title" sortOrder="60">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="escape" xsi:type="boolean">true</item>
                    <item name="truncate" xsi:type="number">80</item>
                </item>
            </argument>
            <settings>
                <filter>text</filter>
                <label translate="true">Title</label>
            </settings>
        </column>
        <column name="source_hash" sortOrder="70">
            <settings>
                <filter>text</filter>
                <label translate="true">Source Hash</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="created_at"
                class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date"
                sortOrder="80">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created</label>
            </settings>
        </column>
        <column name="updated_at"
                class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date"
                sortOrder="90">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated</label>
            </settings>
        </column>
    </columns>
</listing>
