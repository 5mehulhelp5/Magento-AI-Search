<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="davidbel_ai_search">
        <job name="davidbel_ai_search_chunk_processing"
             instance="DavidBel\AiSearch\Cron\ChunkProcessing"
             method="execute">
            <schedule>* * * * *</schedule>
        </job>
    </group>
    <group id="davidbel_ai_search_maintenance">
        <job name="davidbel_ai_search_chunk_processing_retry"
             instance="DavidBel\AiSearch\Cron\ChunkProcessingRetry"
             method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
        <job name="davidbel_ai_search_chunk_processing_cleanup"
             instance="DavidBel\AiSearch\Cron\ChunkProcessingCleanup"
             method="execute">
            <schedule>0 0 * * *</schedule>
        </job>
    </group>
    <group id="davidbel_ai_search_deletion">
        <job name="davidbel_ai_search_chunk_deletion"
             instance="DavidBel\AiSearch\Cron\ChunkDeletion"
             method="execute">
            <schedule>* * * * *</schedule>
        </job>
    </group>
</config>
