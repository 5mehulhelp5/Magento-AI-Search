<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/config.xsd">
    <default>
        <davidbel_ai_search_search_source>
            <ai_server>
                <base_url>http://host.docker.internal:1234</base_url>
                <embedding_model>text-embedding-embeddinggemma-300m-qat</embedding_model>
                <vector_dimensions>768</vector_dimensions>
                <request_timeout_seconds>60</request_timeout_seconds>
                <embedder_document_template>title: {title} | text: {text}</embedder_document_template>
                <maximum_chunk_tokens>350</maximum_chunk_tokens>
                <chunk_overlap_tokens>50</chunk_overlap_tokens>
                <estimated_characters_per_token>4</estimated_characters_per_token>
            </ai_server>
            <search_engine>
                <vector_engine>faiss</vector_engine>
                <vector_space>l2</vector_space>
            </search_engine>
            <document_configuration>
                <enable_document_title>1</enable_document_title>
                <document_title>name</document_title>
                <documents><![CDATA[
                    {
                        "description": {
                            "attribute_code": "description",
                            "composite": "1",
                            "parsing_strategy": "html_to_text"
                        },
                        "name": {
                            "attribute_code": "name",
                            "composite": "0",
                            "parsing_strategy": "text_as_is"
                        }
                    }
                ]]></documents>
                <enable_dynamic_document>0</enable_dynamic_document>
                <dynamic_document><![CDATA[
                    {
                        "name": {
                            "attribute_code": ["name"],
                            "composite": "0",
                            "parsing_strategy": "text_as_is",
                            "template": "This product is called {name}."
                        },
                        "color_size": {
                            "attribute_code": ["color", "size"],
                            "composite": "1",
                            "parsing_strategy": "text_as_is",
                            "template": "It is available in {color}, with size options including {size}."
                        },
                        "material": {
                            "attribute_code": ["material"],
                            "composite": "1",
                            "parsing_strategy": "text_as_is",
                            "template": "It is made from {material}."
                        },
                        "pattern": {
                            "attribute_code": ["pattern"],
                            "composite": "1",
                            "parsing_strategy": "text_as_is",
                            "template": "Its design features a {pattern} pattern."
                        },
                        "activity": {
                            "attribute_code": ["activity"],
                            "composite": "1",
                            "parsing_strategy": "text_as_is",
                            "template": "It is designed for {activity}."
                        },
                        "climate": {
                            "attribute_code": ["climate"],
                            "composite": "1",
                            "parsing_strategy": "text_as_is",
                            "template": "It is well suited to {climate} conditions."
                        },
                        "short_description": {
                            "attribute_code": ["short_description"],
                            "composite": "1",
                            "parsing_strategy": "html_to_text",
                            "template": "Here is a brief description: {short_description}"
                        }
                    }
                ]]></dynamic_document>
            </document_configuration>
        </davidbel_ai_search_search_source>
        <davidbel_ai_search_data_processing>
            <document_processing>
                <batch_size>200</batch_size>
            </document_processing>
            <vector_embedding>
                <batch_size>100</batch_size>
                <concurrent_requests>3</concurrent_requests>
                <maximum_runtime_seconds>600</maximum_runtime_seconds>
            </vector_embedding>
            <vector_deletion>
                <batch_size>1000</batch_size>
                <upsert_attempt_threshold>3</upsert_attempt_threshold>
                <maximum_runtime_seconds>600</maximum_runtime_seconds>
            </vector_deletion>
            <retry>
                <attempt_threshold>3</attempt_threshold>
            </retry>
            <cleanup>
                <attempt_threshold>3</attempt_threshold>
                <result_retention>24</result_retention>
            </cleanup>
            <indexer>
                <lock_timeout_seconds>10</lock_timeout_seconds>
            </indexer>
        </davidbel_ai_search_data_processing>
        <davidbel_ai_search_search_result>
            <general>
                <enabled>1</enabled>
                <request_timeout_seconds>2</request_timeout_seconds>
                <use_previous_semantic_index_during_rebuild>1</use_previous_semantic_index_during_rebuild>
            </general>
            <search_relevance>
                <collapse_results_by_product>1</collapse_results_by_product>
                <product_result_limit>1000</product_result_limit>
                <chunk_candidate_limit>3000</chunk_candidate_limit>
                <minimum_score>0.46</minimum_score>
            </search_relevance>
            <embedding>
                <embedder_query_template>task: search result | query: {text}</embedder_query_template>
            </embedding>
        </davidbel_ai_search_search_result>
    </default>
</config>
