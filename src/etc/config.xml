<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/config.xsd">
    <default>
        <davidbel_ai_search>
            <embedded_attributes>
                <title_attribute_code>name</title_attribute_code>
                <attributes>
                    <description>
                        <attribute_code>description</attribute_code>
                        <composite>1</composite>
                        <parsing_strategy>html_to_text</parsing_strategy>
                    </description>
                    <name>
                        <attribute_code>name</attribute_code>
                        <composite>0</composite>
                        <parsing_strategy>text_as_is</parsing_strategy>
                    </name>
                    <embedding_template>
                        <attribute_code>embedding_template</attribute_code>
                        <composite>0</composite>
                        <parsing_strategy>text_as_is</parsing_strategy>
                        <children>
                            <name>
                                <attribute_code>name</attribute_code>
                                <composite>0</composite>
                                <parsing_strategy>text_as_is</parsing_strategy>
                                <template>This product is called {name}.</template>
                            </name>
                            <color_size>
                                <attribute_code>color,size</attribute_code>
                                <composite>1</composite>
                                <parsing_strategy>text_as_is</parsing_strategy>
                                <template>It is available in {color}, with size options including {size}.</template>
                            </color_size>
                            <material>
                                <attribute_code>material</attribute_code>
                                <composite>1</composite>
                                <parsing_strategy>text_as_is</parsing_strategy>
                                <template>It is made from {material}.</template>
                            </material>
                            <pattern>
                                <attribute_code>pattern</attribute_code>
                                <composite>1</composite>
                                <parsing_strategy>text_as_is</parsing_strategy>
                                <template>Its design features a {pattern} pattern.</template>
                            </pattern>
                            <activity>
                                <attribute_code>activity</attribute_code>
                                <composite>1</composite>
                                <parsing_strategy>text_as_is</parsing_strategy>
                                <template>It is designed for {activity}.</template>
                            </activity>
                            <climate>
                                <attribute_code>climate</attribute_code>
                                <composite>1</composite>
                                <parsing_strategy>text_as_is</parsing_strategy>
                                <template>It is well suited to {climate} conditions.</template>
                            </climate>
                            <short_description>
                                <attribute_code>short_description</attribute_code>
                                <composite>1</composite>
                                <parsing_strategy>html_to_text</parsing_strategy>
                                <template>Here is a brief description: {short_description}</template>
                            </short_description>
                        </children>
                    </embedding_template>
                </attributes>
            </embedded_attributes>
            <embedder>
                <base_url>http://host.docker.internal:1234</base_url>
                <model>text-embedding-embeddinggemma-300m-qat</model>
                <vector_dimensions>768</vector_dimensions>
                <request_timeout_seconds>60</request_timeout_seconds>
                <document_template>title: {title} | text: {text}</document_template>
                <query_template>task: search result | query: {text}</query_template>
                <maximum_chunk_tokens>350</maximum_chunk_tokens>
                <chunk_overlap_tokens>50</chunk_overlap_tokens>
                <estimated_characters_per_token>4</estimated_characters_per_token>
            </embedder>
            <ingestion>
                <document_processing_batch_size>200</document_processing_batch_size>
                <embedding_batch_size>100</embedding_batch_size>
                <concurrent_embedding_requests>3</concurrent_embedding_requests>
                <embedding_maximum_runtime_seconds>600</embedding_maximum_runtime_seconds>
                <deletion_batch_size>1000</deletion_batch_size>
                <deletion_upsert_attempt_threshold>3</deletion_upsert_attempt_threshold>
                <deletion_maximum_runtime_seconds>600</deletion_maximum_runtime_seconds>
                <retry_attempt_threshold>3</retry_attempt_threshold>
                <cleanup_attempt_threshold>3</cleanup_attempt_threshold>
                <cleanup_result_retention>-24 hours</cleanup_result_retention>
            </ingestion>
            <search>
                <index_name>davidbel_ai_search_chunks</index_name>
                <index_schema_version>1</index_schema_version>
                <vector_method>hnsw</vector_method>
                <vector_engine>faiss</vector_engine>
                <vector_space>l2</vector_space>
                <lock_timeout_seconds>10</lock_timeout_seconds>
            </search>
            <storefront>
                <enabled>1</enabled>
                <request_timeout_seconds>2</request_timeout_seconds>
                <use_previous_semantic_index_during_rebuild>1</use_previous_semantic_index_during_rebuild>
                <collapse_results_by_product>1</collapse_results_by_product>
                <product_result_limit>1000</product_result_limit>
                <chunk_candidate_limit>3000</chunk_candidate_limit>
                <minimum_score>0.46</minimum_score>
            </storefront>
        </davidbel_ai_search>
    </default>
</config>
