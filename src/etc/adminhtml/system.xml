<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="davidbel" translate="label" sortOrder="500">
            <label>AI Search</label>
        </tab>
        <section id="davidbel_ai_search_search_result"
                 translate="label"
                 type="text"
                 sortOrder="500"
                 showInDefault="1"
                 showInWebsite="1"
                 showInStore="1">
            <label>Search Result</label>
            <tab>davidbel</tab>
            <resource>DavidBel_AiSearch::config_search_result</resource>
            <group id="general"
                   translate="label"
                   type="text"
                   sortOrder="10"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">
                <label>General</label>
                <field id="enabled"
                       translate="label"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1"
                       canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="request_timeout_seconds"
                       translate="label"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1"
                       canRestore="1">
                    <label>Request Timeout (Seconds)</label>
                    <validate>required-entry validate-number validate-greater-than-zero</validate>
                </field>
                <field id="use_previous_semantic_index_during_rebuild"
                       translate="label"
                       type="select"
                       sortOrder="30"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1"
                       canRestore="1">
                    <label>Use Previous Semantic Index During Rebuild</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="search_relevance"
                   translate="label"
                   type="text"
                   sortOrder="20"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">
                <label>Search Relevance</label>
                <field id="collapse_results_by_product"
                       translate="label"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1"
                       canRestore="1">
                    <label>Collapse Results by Product</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="product_result_limit"
                       translate="label"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1"
                       canRestore="1">
                    <label>Product Result Limit</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="minimum_score"
                       translate="label"
                       type="text"
                       sortOrder="30"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1"
                       canRestore="1">
                    <label>Minimum Score</label>
                    <validate>required-entry validate-number validate-zero-or-greater</validate>
                </field>
            </group>
            <group id="embedding"
                   translate="label"
                   type="text"
                   sortOrder="30"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">
                <label>Embedding</label>
                <field id="embedder_query_template"
                       translate="label"
                       type="text"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1"
                       canRestore="1">
                    <label>Embedder Query Template</label>
                    <validate>required-entry</validate>
                </field>
            </group>
        </section>
        <section id="davidbel_ai_search_search_source"
                 translate="label"
                 type="text"
                 sortOrder="510"
                 showInDefault="1">
            <label>Search Source</label>
            <tab>davidbel</tab>
            <resource>DavidBel_AiSearch::config_search_source</resource>
            <frontend_model>DavidBel\AiSearch\Block\Adminhtml\System\Config\SearchSource</frontend_model>
            <group id="ai_server"
                   translate="label"
                   type="text"
                   sortOrder="10"
                   showInDefault="1">
                <label>AI Server</label>
                <field id="base_url"
                       translate="label"
                       type="text"
                       sortOrder="10"
                       showInDefault="1"
                       canRestore="1">
                    <label>Base URL</label>
                    <validate>required-entry validate-url</validate>
                </field>
                <field id="embedding_model"
                       translate="label tooltip"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       canRestore="1">
                    <label>Embedding Model</label>
                    <tooltip>Changing this setting requires a full AI Search rebuild. The rebuild may send many requests to the configured AI server and take a significant amount of time.</tooltip>
                    <validate>required-entry</validate>
                </field>
                <field id="vector_dimensions"
                       translate="label tooltip"
                       type="text"
                       sortOrder="30"
                       showInDefault="1"
                       canRestore="1">
                    <label>Vector Dimensions</label>
                    <tooltip>Changing this setting requires a full AI Search rebuild. The rebuild may send many requests to the configured AI server and take a significant amount of time.</tooltip>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="request_timeout_seconds"
                       translate="label"
                       type="text"
                       sortOrder="40"
                       showInDefault="1"
                       canRestore="1">
                    <label>Request Timeout (Seconds)</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="embedder_document_template"
                       translate="label tooltip"
                       type="text"
                       sortOrder="50"
                       showInDefault="1"
                       canRestore="1">
                    <label>Embedder Document Template</label>
                    <tooltip>Changing this setting requires a full AI Search rebuild. The rebuild may send many requests to the configured AI server and take a significant amount of time.</tooltip>
                    <validate>required-entry</validate>
                </field>
                <field id="maximum_chunk_tokens"
                       translate="label tooltip"
                       type="text"
                       sortOrder="60"
                       showInDefault="1"
                       canRestore="1">
                    <label>Maximum Chunk Tokens</label>
                    <tooltip>Changing this setting requires a full AI Search rebuild. The rebuild may send many requests to the configured AI server and take a significant amount of time.</tooltip>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="chunk_overlap_tokens"
                       translate="label tooltip"
                       type="text"
                       sortOrder="70"
                       showInDefault="1"
                       canRestore="1">
                    <label>Chunk Overlap Tokens</label>
                    <tooltip>Changing this setting requires a full AI Search rebuild. The rebuild may send many requests to the configured AI server and take a significant amount of time.</tooltip>
                    <validate>required-entry validate-digits validate-zero-or-greater</validate>
                </field>
                <field id="estimated_characters_per_token"
                       translate="label tooltip"
                       type="text"
                       sortOrder="80"
                       showInDefault="1"
                       canRestore="1">
                    <label>Estimated Characters per Token</label>
                    <tooltip>Changing this setting requires a full AI Search rebuild. The rebuild may send many requests to the configured AI server and take a significant amount of time.</tooltip>
                    <validate>required-entry validate-number validate-greater-than-zero</validate>
                </field>
            </group>
            <group id="search_engine"
                   translate="label"
                   type="text"
                   sortOrder="20"
                   showInDefault="1">
                <label>Search Engine</label>
                <field id="vector_engine"
                       translate="label tooltip"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       canRestore="1">
                    <label>Vector Engine</label>
                    <tooltip>Changing this setting requires a full AI Search rebuild. The rebuild may send many requests to the configured AI server and take a significant amount of time.</tooltip>
                    <source_model>DavidBel\AiSearch\Model\Config\Source\VectorEngine</source_model>
                </field>
                <field id="vector_space"
                       translate="label tooltip"
                       type="select"
                       sortOrder="20"
                       showInDefault="1"
                       canRestore="1">
                    <label>Vector Space</label>
                    <tooltip>Changing this setting requires a full AI Search rebuild. The rebuild may send many requests to the configured AI server and take a significant amount of time.</tooltip>
                    <source_model>DavidBel\AiSearch\Model\Config\Source\VectorSpace</source_model>
                </field>
            </group>
            <group id="document_configuration"
                   translate="label"
                   type="text"
                   sortOrder="30"
                   showInDefault="1">
                <label>Document Configuration</label>
                <field id="enable_document_title"
                       translate="label tooltip"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       canRestore="1">
                    <label>Enable Document Title</label>
                    <tooltip>Changing this setting requires a full AI Search rebuild. The rebuild may send many requests to the configured AI server and take a significant amount of time.</tooltip>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="document_title"
                       translate="label tooltip"
                       type="select"
                       sortOrder="20"
                       showInDefault="1"
                       canRestore="1">
                    <label>Document Title</label>
                    <tooltip>Changing this setting requires a full AI Search rebuild. The rebuild may send many requests to the configured AI server and take a significant amount of time.</tooltip>
                    <source_model>DavidBel\AiSearch\Model\Config\Source\ProductAttribute</source_model>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="enable_document_title">1</field>
                    </depends>
                </field>
                <field id="documents"
                       translate="label tooltip"
                       sortOrder="30"
                       showInDefault="1"
                       canRestore="1">
                    <label>Documents</label>
                    <tooltip>Changing this setting requires a full AI Search rebuild. The rebuild may send many requests to the configured AI server and take a significant amount of time.</tooltip>
                    <frontend_model>DavidBel\AiSearch\Block\Adminhtml\System\Config\Form\Field\Documents</frontend_model>
                    <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                </field>
                <field id="enable_dynamic_document"
                       translate="label tooltip"
                       type="select"
                       sortOrder="40"
                       showInDefault="1"
                       canRestore="1">
                    <label>Enable Dynamic Document</label>
                    <tooltip>Changing this setting requires a full AI Search rebuild. The rebuild may send many requests to the configured AI server and take a significant amount of time.</tooltip>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="dynamic_document"
                       translate="label tooltip"
                       sortOrder="50"
                       showInDefault="1"
                       canRestore="1">
                    <label>Dynamic Document</label>
                    <tooltip>Changing this setting requires a full AI Search rebuild. The rebuild may send many requests to the configured AI server and take a significant amount of time.</tooltip>
                    <frontend_model>DavidBel\AiSearch\Block\Adminhtml\System\Config\Form\Field\DynamicDocument</frontend_model>
                    <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                    <depends>
                        <field id="enable_dynamic_document">1</field>
                    </depends>
                </field>
            </group>
        </section>
        <section id="davidbel_ai_search_data_processing"
                 translate="label"
                 type="text"
                 sortOrder="520"
                 showInDefault="1">
            <label>Data Processing</label>
            <tab>davidbel</tab>
            <resource>DavidBel_AiSearch::config_data_processing</resource>
            <group id="document_processing"
                   translate="label"
                   type="text"
                   sortOrder="10"
                   showInDefault="1">
                <label>Document Processing</label>
                <field id="batch_size"
                       translate="label"
                       type="text"
                       sortOrder="10"
                       showInDefault="1"
                       canRestore="1">
                    <label>Batch Size</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
            <group id="vector_embedding"
                   translate="label"
                   type="text"
                   sortOrder="20"
                   showInDefault="1">
                <label>Vector Embedding</label>
                <field id="batch_size"
                       translate="label"
                       type="text"
                       sortOrder="10"
                       showInDefault="1"
                       canRestore="1">
                    <label>Batch Size</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="concurrent_requests"
                       translate="label"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       canRestore="1">
                    <label>Concurrent Requests</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="maximum_runtime_seconds"
                       translate="label"
                       type="text"
                       sortOrder="30"
                       showInDefault="1"
                       canRestore="1">
                    <label>Maximum Runtime (Seconds)</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
            <group id="vector_delete"
                   translate="label"
                   type="text"
                   sortOrder="30"
                   showInDefault="1">
                <label>Vector Delete</label>
                <field id="batch_size"
                       translate="label"
                       type="text"
                       sortOrder="10"
                       showInDefault="1"
                       canRestore="1">
                    <label>Batch Size</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="upsert_attempt_threshold"
                       translate="label"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       canRestore="1">
                    <label>Upsert Attempt Threshold</label>
                    <validate>required-entry validate-digits validate-zero-or-greater</validate>
                </field>
                <field id="maximum_runtime_seconds"
                       translate="label"
                       type="text"
                       sortOrder="30"
                       showInDefault="1"
                       canRestore="1">
                    <label>Maximum Runtime (Seconds)</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
            <group id="retry"
                   translate="label"
                   type="text"
                   sortOrder="40"
                   showInDefault="1">
                <label>Retry</label>
                <field id="attempt_threshold"
                       translate="label"
                       type="text"
                       sortOrder="10"
                       showInDefault="1"
                       canRestore="1">
                    <label>Attempt Threshold</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
            <group id="cleanup"
                   translate="label"
                   type="text"
                   sortOrder="50"
                   showInDefault="1">
                <label>Cleanup</label>
                <field id="attempt_threshold"
                       translate="label"
                       type="text"
                       sortOrder="10"
                       showInDefault="1"
                       canRestore="1">
                    <label>Attempt Threshold</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="result_retention"
                       translate="label"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       canRestore="1">
                    <label>Result Retention (Hours)</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
            <group id="indexer"
                   translate="label"
                   type="text"
                   sortOrder="60"
                   showInDefault="1">
                <label>Indexer</label>
                <field id="lock_timeout_seconds"
                       translate="label"
                       type="text"
                       sortOrder="10"
                       showInDefault="1"
                       canRestore="1">
                    <label>Lock Timeout (Seconds)</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="minimum_success_percentage"
                       translate="label"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       canRestore="1">
                    <label>Minimum Successful Full Reindex (%)</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
        </section>
    </system>
</config>
